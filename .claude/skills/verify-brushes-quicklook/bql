    for folder, extension in CORPUS_EXTENSIONS.items():
        for source in sorted((CORPUS / folder).iterdir()):
            target = corpus_dir / f"{source.name}.{extension}"
            if target.exists():
                raise Fail(f"Two corpus files map to {target.name}", "Rename one of them in bql's corpus copy.")
            shutil.copyfile(source, target)
            copied.append(str(target))
    real_dir = os.environ.get(REAL_FILES_ENV)
