def cmd_hostile(args):
    targets = args.paths
    if not targets:
        corpus_dir = FIXTURES / "corpus"
        if not corpus_dir.is_dir():
            raise Fail("No fixtures yet", "Run `bql fixtures` first, or pass folders or files.")
        targets = [str(corpus_dir)] + ([os.environ[REAL_FILES_ENV]] if os.environ.get(REAL_FILES_ENV) else [])
    files = brush_files(targets)
    run_dir = new_run("hostile")
    before = crash_reports()
    started = []
    rows = []
    for file in files:
        note(f"hostile {file.name}")
        started.append(time.time())
        thumbnail = render_thumbnail(file, 256, 1, run_dir / "thumb")
        preview = drive_previews([file], run_dir, args.settle, args.via)[0]
        app = open_in_app(file, run_dir, args.settle)
        rows.append({"file": str(file), "thumbnail_png": thumbnail["png"], "preview_png": preview["png"],
                     "extension": preview["extension"], "attempts": preview["attempts"],
                     "app_png": app["png"], "app_pid": app["pid"],
                     "problems": [p for p in [None if thumbnail["png"] else "no thumbnail: " + thumbnail["qlmanage"],
                                              preview["problem"], app["problem"]] if p]})
    crashes, capped, vanished = wait_for_new_crashes(before, started[0])
    for crash in crashes:
        i = bisect_right(started, crash["time"]) if crash["time"] is not None else 0
        crash["likely_file"] = rows[i - 1]["file"] if i else None
    failures, crash_fields = crash_verdict(crashes, capped, vanished)
    unexercised = [row["file"] for row in rows if row["problems"]]
    if unexercised:
        failures.append((f"{len(unexercised)} of {len(rows)} files were not exercised",
                         "Read the `problems` of each file in `unexercised` under `results`. "
                         "Run `bql doctor` to check that the app and both extensions are installed and registered."))
    retried = sum(row["attempts"] > 1 for row in rows)
    # Drills measured 6 retries in 3381 previews. More than this limit points at a new hang before preparePreviewOfFile.
    # It is tuned for the small corpus in CI and lenient on large sweeps.
    retry_limit = 1 + len(rows) // 100
    if retried > retry_limit:
        failures.append((f"{retried} files needed a second qlmanage attempt, above the limit of {retry_limit}",
                         "Rerun the files whose result has `attempts: 2` through `bql preview`. If `attempts` is 2 "
                         "again, the preview extension hangs before preparePreviewOfFile. Read `bql logs` right after."))
    ok = not failures
    if summary_path := os.environ.get("GITHUB_STEP_SUMMARY"):
        try:
            with open(summary_path, "a") as summary:
                summary.write(f"Hostile sweep {'passed' if ok else 'failed'}: {len(rows)} files, {len(crashes)} crashed, "
                              f"{len(unexercised)} unexercised, {retried} retried (limit {retry_limit})"
                              f"{f', crash wait capped at {CRASH_WAIT_CAP} s' if capped else ''}.\n")
        except OSError as error:
            note(f"cannot write the job summary: {error}")
    finish(run_dir, {"via": args.via, "files": len(rows), "crashed": len(crashes), "unexercised": unexercised,
                     "retried": retried, "retry_limit": retry_limit,
                     **crash_fields, "results": rows}, failures)


def cmd_logs(args):
    start = datetime.now() - timedelta(seconds=args.last)
    events = log_since(start, f'subsystem == "{BUNDLE_ID}"', signposts=True)

    def at(event):
        return datetime.strptime(event["timestamp"], "%Y-%m-%d %H:%M:%S.%f%z")

    begins, ends = {}, {}
    for event in events:
        if event.get("eventType") == "signpostEvent" and event.get("signpostType") in ("begin", "end"):
            key = (event["processID"], event["signpostID"], event["signpostName"])
            (begins if event["signpostType"] == "begin" else ends).setdefault(key, event)
    loads = []
    for (pid, signpost_id, name), begin in begins.items():
        if name != "load":
            continue
        ms = {}
        for interval in ("load", "read", "parse", "tips"):
            key = (pid, signpost_id, interval)
            if key in begins:
                end = ends.get(key)
                ms[interval] = round((at(end) - at(begins[key])).total_seconds() * 1000, 2) if end else None
        read = begins.get((pid, signpost_id, "read"), {}).get("eventMessage")
        detail = ", ".join(filter(None, [begin["eventMessage"], read]))
        loads.append({"process": Path(begin.get("processImagePath", "")).name, "pid": pid,
                      "time": begin["timestamp"], "detail": detail, "ms": ms})
    loads.sort(key=lambda load: load["time"])
    messages = [{"time": e["timestamp"], "process": Path(e.get("processImagePath", "")).name,
                 "category": e.get("category"), "level": e.get("messageType"), "message": e["eventMessage"]}
                for e in events if e.get("eventType") == "logEvent"]
    since = start.isoformat(timespec="seconds")
    if not loads:
        emit({"ok": False, "since": since, "messages": messages,
              "error": f"No load intervals from {BUNDLE_ID} in the last {args.last:g} s",
              "fix": "Drive a `bql thumb` or `bql preview` first, or raise --last. "
                     "Run `bql doctor` to check that the installed build is one that logs."}, 1)
    emit({"ok": True, "since": since, "loads": loads, "messages": messages})


def cmd_cleanup(args):
    state = load_state()
    killed, ended, closed = [], [], []
    for record in state["qlmanage"]:
        command = run(["ps", "-p", str(record["pid"]), "-o", "command="]).stdout.strip()
        if command.startswith("qlmanage -p") and record["file"] in command:
            os.kill(record["pid"], 15)
            killed.append(record)
    for record in state["app"]:
        # A pid that no longer carries the token is another process that reused it.
        if record.get("token") and record["token"] in run(["ps", "-o", "command=", "-p", str(record["pid"])]).stdout:
            try:
                os.kill(record["pid"], 15)
                ended.append(record)
            except ProcessLookupError:
                pass
    for window_id in state["finder_windows"]:
        if osascript(CLOSE_FINDER_WINDOW, window_id).stdout.strip() not in ("", "0"):
            closed.append(window_id)
    quit_app = False
    if state["host_app_opened"]:
        quit_app = osascript(f'tell application id "{BUNDLE_ID}" to quit').returncode == 0
    shutil.rmtree(FIXTURES, ignore_errors=True)
    STATE.unlink(missing_ok=True)
    runs = sorted(p.name for p in EVIDENCE.iterdir()) if EVIDENCE.is_dir() else []
    emit({"ok": True, "killed_qlmanage": killed, "ended_app_instances": ended, "closed_finder_windows": closed,
          "quit_host_app": quit_app, "removed": str(FIXTURES), "evidence_dir": str(EVIDENCE), "evidence_runs_kept": runs})


def main():
    parser = ArgumentParser(
        prog="bql", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Typical run: bql doctor; bql fixtures; bql thumb <file>; bql preview <file>; bql cleanup")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("doctor", help="read-only: fail unless the installed app is this checkout's Release build, "
                   "registered once, and the only code its live processes run")
    check = sub.add_parser("check-build", help="check a Release build for universal binaries, hardened runtime, "
                           "sandbox, brush types, privacy manifests, icon, category and encryption flag")
    check.add_argument("app", help=f"the BrushesQuickLook.app to check, such as {BUILD.relative_to(REPO)}")
    install = sub.add_parser("install", help=f"build Release, check it, unregister other copies, replace {APP}, "
                             "register and open it, then fail on any problem `bql doctor` reports")
    source = install.add_mutually_exclusive_group()
    source.add_argument("--no-build", action="store_true",
                        help=f"install the existing Release build at {BUILD.relative_to(REPO)}, for CI and the VM guest")
    source.add_argument("--main", action="store_true",
                        help="build origin/main in a temporary worktree and install that, then remove the worktree")
    sub.add_parser("fixtures", help=f"copy ffi/tests/corpus with brush extensions; list files in ${REAL_FILES_ENV}")
    thumb = sub.add_parser("thumb", help="render Finder thumbnails headlessly with qlmanage -x -t")
    thumb.add_argument("files", nargs="+", help="brush files or folders of them")
    thumb.add_argument("--size", type=int, action="append", help="icon size in points, repeatable (default 256 and 48)")
    thumb.add_argument("--scale", type=float, default=1, help="backing scale factor (default 1)")
    for name, help_text in [("preview", "open the space-bar preview in a qlmanage window and capture it"),
                            ("finder", "select the file in a new Finder window, press space, capture the panel")]:
        command = sub.add_parser(name, help=help_text)
        command.add_argument("files", nargs="+", help="brush files or folders of them")
        command.add_argument("--settle", type=float, default=2, help="seconds to wait after the window appears")
    hostile = sub.add_parser("hostile", help="thumbnail, preview and open in a new app instance every file, "
                             "fail on a crash, a capped crash-report wait, an unexercised file or too many retries")
    hostile.add_argument("paths", nargs="*", help=f"files or folders (default: the fixture corpus and ${REAL_FILES_ENV})")
    hostile.add_argument("--via", choices=sorted(DRIVERS), default="qlmanage", help="preview driver (default qlmanage)")
    hostile.add_argument("--settle", type=float, default=2, help="seconds to wait after the window appears")
    logs = sub.add_parser("logs", help="per-load read/parse/tips intervals and extension log messages from the unified log")
    logs.add_argument("--last", type=float, default=300, help="seconds of log to read (default 300)")
    sub.add_parser("cleanup", help="kill the qlmanage, app instances and Finder windows bql started, delete fixtures, "
                   "keep evidence")
    args, extra = parser.parse_known_args()
    if extra:
        sub.choices[args.command].error(f"unrecognized arguments: {' '.join(extra)}")
    if args.command == "thumb" and not args.size:
        args.size = [256, 48]
    try:
        globals()[f"cmd_{args.command.replace('-', '_')}"](args)
    except Exception as error:
        message, fix = describe(error)
        emit({"ok": False, "error": message, "fix": fix}, 2)


if __name__ == "__main__":
    main()
