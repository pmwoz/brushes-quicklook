class Fail(Exception):
    def __init__(self, error, fix):
        super().__init__(error)
        self.error = error
        self.fix = fix


def emit(result, code=0):
    print(json.dumps(result, indent=2, default=str))
    sys.exit(code)


def describe(error):
    if isinstance(error, Fail):
        return error.error, error.fix
    traceback.print_exc()
    return (f"{type(error).__name__}: {error}",
            "bql hit an unexpected error or a hung system command. Read the traceback on stderr.")


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        emit({"ok": False, "error": f"{self.prog}: {message}", "fix": f"Run `{self.prog} --help` for the arguments."}, 2)


def note(message):
    print(message, file=sys.stderr, flush=True)


def run(args, timeout=120, check=False, input=None):
    proc = subprocess.run(args, input=input, capture_output=True, text=True, timeout=timeout)
    if check and proc.returncode != 0:
        raise Fail(f"{' '.join(map(str, args))} exited {proc.returncode}: {proc.stderr.strip() or proc.stdout.strip()}",
                   "Run the command by hand to see the full error.")
    return proc


def osascript(script, *args, language="AppleScript"):
    try:
        return run(["osascript", "-l", language, "-e", script, *map(str, args)], timeout=60)
    except subprocess.TimeoutExpired as error:
        # Only an Apple Event to another app waits on an Automation prompt. WINDOWS_JS sends none.
        target = re.search(r'tell application (?:id )?"([^"]+)"', script)
        if not target:
            raise
        raise Fail(f"osascript did not return within {error.timeout:g} s. Its Apple Event to {target[1]} waits "
                   "while an Automation prompt is pending.",
                   f"On the host, answer the prompt, or allow the app running this shell to control {target[1]} in "
                   "System Settings > Privacy & Security > Automation, then rerun. In a Tart guest, run `vm down` "
                   "and `vm up` with the same `--image`.")


# State: what this CLI started, so cleanup kills exactly that and nothing else.

def load_state():
    state = {"qlmanage": [], "finder_windows": [], "app": [], "host_app_opened": False}
    if STATE.exists():
        state |= json.loads(STATE.read_text())
    return state


def save_state(state):
    WORK.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=2))


def track(key, value):
    state = load_state()
    state[key].append(value)
    save_state(state)


def untrack(key, value):
    state = load_state()
    state[key] = [item for item in state[key] if item != value]
    save_state(state)


def new_run(command):
    directory = EVIDENCE / f"{datetime.now().strftime('%Y%m%d-%H%M%S')}-{command}"
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def verdict(result, failures):
    """Each failure is an (error, fix) pair. The result passes when there are none."""
    result = {"ok": not failures, **result}
    if failures:
        result |= {"error": ". ".join(error for error, _ in failures),
                   "fix": " ".join(dict.fromkeys(fix for _, fix in failures))}
    return result


def finish(run_dir, result, failures):
    result = verdict({"evidence_dir": str(run_dir), **result}, failures)
    (run_dir / "result.json").write_text(json.dumps(result, indent=2, default=str))
    emit(result, 1 if failures else 0)


def brush_files(paths):
    files = []
    for path in map(Path, paths):
        if not path.exists():
            raise Fail(f"{path} does not exist", "Pass existing files or folders. Run `bql fixtures` for the corpus.")
        candidates = sorted(path.iterdir()) if path.is_dir() else [path]
        files += [p.absolute() for p in candidates if p.is_file() and p.suffix[1:].lower() in BRUSH_EXTENSIONS]
    if not files:
        raise Fail(f"No .abr, .brush or .brushset files in {', '.join(map(str, paths))}",
                   "Quick Look routes files to the extensions by extension. Run `bql fixtures` for named copies.")
    return files


def crash_reports():
    if not CRASH_DIR.is_dir():
        return {}
    return {p.name: p for p in CRASH_DIR.iterdir() if p.name.startswith("Brushes")}


def capture_time(report):
    """ReportCrash writes the file seconds, sometimes hours, after the crash."""
    try:
        body = json.loads(report.read_text().split("\n", 1)[1])
        return datetime.strptime(body["captureTime"], "%Y-%m-%d %H:%M:%S.%f %z").timestamp()
    except (OSError, IndexError, KeyError, ValueError):
        return None


def run_crashes(before, since):
    crashes = [{"report": str(path), "process": re.split(r"[-_.]", name)[0], "time": capture_time(path)}
               for name, path in sorted(crash_reports().items()) if name not in before]
    return [crash for crash in crashes if crash["time"] is None or crash["time"] >= since]


def wait_for_new_crashes(before, since):
    # A hosted runner wrote reports up to 25 s after the crash, so wait until none from the run has arrived for 30 s.
    # Crashes can keep reports coming, so stop at the cap.
    note("waiting for crash reports")
    crashes, quiet_since = run_crashes(before, since), time.time()
    seen = {crash["report"] for crash in crashes}
    restarted = set()
    deadline = quiet_since + CRASH_WAIT_CAP
    capped = False
    while time.time() - quiet_since < 30:
        if time.time() > deadline:
            note(f"no quiet 30 s before the {CRASH_WAIT_CAP} s cap, the run fails")
            capped = True
            break
        time.sleep(1)
        crashes = run_crashes(before, since)
        arrived = {crash["report"] for crash in crashes} - seen
        if arrived:
            seen |= arrived
            restarted |= arrived
            quiet_since = time.time()
    return crashes, capped, restarted - {crash["report"] for crash in crashes}


def readable(crashes):
    return [{**crash, "time": crash["time"] and datetime.fromtimestamp(crash["time"]).isoformat(timespec="seconds")}
            for crash in crashes]


def crash_verdict(crashes, capped, vanished):
    failures = []
    if crashes:
        failures.append((f"Brushes crash reports from this run: {len(crashes)}",
                         "Open each report in `new_crash_reports`, find the crashing frame and fix it. "
                         "The app and the extensions must never crash on a hostile file."))
    if capped and vanished:
        failures.append((f"Brushes crash reports that restarted the crash wait until its {CRASH_WAIT_CAP} s cap, "
                         f"then were deleted or finished writing with a captureTime before the run: {len(vanished)}. "
                         "A crash from this run may be missing",
                         "Stop whatever deletes Brushes* reports in ~/Library/Logs/DiagnosticReports during a run, "
                         "or wait until ReportCrash stops writing reports of earlier crashes, and rerun."))
    elif capped:
        failures.append((f"Reports kept arriving until the {CRASH_WAIT_CAP} s wait ended, so a later crash may be missing",
                         f"Rerun after the fix, because a report that arrived after the {CRASH_WAIT_CAP} s wait "
                         "is not in `new_crash_reports`."))
    return failures, {"new_crash_reports": readable(crashes), "crash_wait_capped": capped}


def windows():
    proc = osascript(WINDOWS_JS, language="JavaScript")
    if proc.returncode != 0:
        raise Fail(f"Cannot list windows: {proc.stderr.strip()}", "Run from a logged-in GUI session.")
    return json.loads(proc.stdout)


def wait_for(probe, timeout, interval=0.25):
    deadline = time.time() + timeout
    while time.time() < deadline:
        found = probe()
        if found:
            return found
        time.sleep(interval)
    return None


def capture(window_id, png):
    png.parent.mkdir(parents=True, exist_ok=True)
    proc = run(["screencapture", "-x", "-o", "-l", str(window_id), str(png)])
    if proc.returncode != 0 or not png.exists():
        raise Fail(f"screencapture failed: {proc.stderr.strip()}",
                   "Grant Screen Recording to the app running this shell in System Settings > Privacy & Security.")


def log_since(start, predicate, signposts=False):
    proc = run(["/usr/bin/log", "show", "--start", start.strftime("%Y-%m-%d %H:%M:%S"),
                "--style", "ndjson", "--predicate", predicate, *(["--signpost"] if signposts else [])], timeout=180)
    return [event for event in map(json.loads, filter(lambda line: line.startswith("{"), proc.stdout.splitlines()))
            if "eventMessage" in event]


@contextmanager
def log_stream(log, *args):
    """Appends `log stream` ndjson to `log` until the block ends. Yields a check that fails once the stream exits."""
    size = log.stat().st_size if log.exists() else 0
    with log.open("a") as out:
        stream = subprocess.Popen(["/usr/bin/log", "stream", "--style", "ndjson", *args],
                                  stdout=out, stderr=subprocess.PIPE, text=True)

    def check():
        if stream.poll() is not None:
            raise Fail(f"`log stream` exited with status {stream.returncode}: {stream.stderr.read().strip()}",
                       "Run `log stream` by hand to see why it fails.")

    try:
        wait_for(lambda: stream.poll() is not None or log.stat().st_size > size, timeout=10)
        check()
        if log.stat().st_size == size:
            raise Fail("`log stream` printed nothing within 10 s", "Run `log stream` by hand to see why it fails.")
        yield check
    finally:
        stream.terminate()
        stream.wait()


def streamed(log):
    return [json.loads(line) for line in log.read_text().splitlines(keepends=True)
            if line.startswith("{") and line.endswith("\n")]


def extension_requests(log):
    """BrushesPreview logs this activity once per preview request, from Finder and qlmanage alike."""
    return [(datetime.strptime(e["timestamp"], "%Y-%m-%d %H:%M:%S.%f%z").timestamp(),
             {"pid": e.get("processID"), "binary": e.get("processImagePath")}) for e in streamed(log)
            if "eventMessage" in e]


def load_ended(log, pid):
    """The app parses a file inside a `load` signpost interval, and a single brush nests a second one inside it."""
    kinds = [e.get("signpostType") for e in streamed(log) if e.get("processID") == pid]
    return kinds.count("begin") > 0 and kinds.count("begin") == kinds.count("end")


# Drivers. Each exercises one file through the real extension and returns what it saw.

def render_thumbnail(file, size, scale, out_dir):
    out = out_dir / f"{size}pt@{scale:g}x"
    out.mkdir(parents=True, exist_ok=True)
    args = ["qlmanage", "-x", "-t", "-s", str(size), "-f", f"{scale:g}", "-o", str(out), str(file)]
    try:
        proc = run(args, timeout=60)
        message = proc.stdout.strip().splitlines()[-2:] if proc.stdout.strip() else [proc.stderr.strip()]
    except subprocess.TimeoutExpired:
        message = ["qlmanage timed out after 60 s and was killed"]
    png = out / f"{file.name}.png"
    if png.exists():
        return {"file": str(file), "size_pt": size, "scale": scale, "png": str(png)}
    return {"file": str(file), "size_pt": size, "scale": scale, "png": None, "qlmanage": " ".join(message)}


def preview_with_qlmanage(file, png, settle):
    proc = subprocess.Popen(["qlmanage", "-p", str(file)], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    record = {"pid": proc.pid, "file": str(file)}
    track("qlmanage", record)
    try:
        window = wait_for(lambda: next((w for w in windows() if w["pid"] == proc.pid and w["layer"] == 0
                                        and w["bounds"]["Height"] > 100), None), timeout=20)
        if window:
            time.sleep(settle)
            capture(window["id"], png)
        return {"file": str(file), "png": str(png) if window else None,
                "problem": None if window else "qlmanage opened no preview window within 20 s"}
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        untrack("qlmanage", record)


def finder_panel():
    # Finder's Quick Look panel is the Finder-owned window on layer 3.
    return next((w for w in windows() if w["owner"] == "Finder" and w["layer"] == 3), None)


def press(key_code):
    proc = osascript(f'tell application "System Events" to key code {key_code}')
    if proc.returncode != 0:
        raise Fail(f"Cannot send key presses: {proc.stderr.strip()}",
                   "Grant Accessibility to the app running this shell in System Settings > Privacy & Security, "
                   "or use `bql preview`, which needs no key presses.")


def preview_with_finder(file, png, settle):
    if finder_panel():
        raise Fail("A Quick Look panel is already open in Finder",
                   "Close it (Escape in Finder) and rerun. The space bar toggles the panel.")
    opened = osascript(OPEN_FINDER_WINDOW, file.parent, file)
    if opened.returncode != 0:
        raise Fail(f"Finder could not open {file.parent}: {opened.stderr.strip()}",
                   "Allow the app running this shell to control Finder in System Settings > Privacy & Security > "
                   "Automation.")
    window_id = int(opened.stdout.strip())
    track("finder_windows", window_id)
    try:
        time.sleep(1)  # sleep-ok: gives Finder time to come to the front before System Events presses space
        press(49)  # space
        panel = wait_for(finder_panel, timeout=10)
        if panel:
            time.sleep(settle)
            capture(panel["id"], png)
            osascript('tell application "Finder" to activate')
            press(53)  # escape
            wait_for(lambda: not finder_panel(), timeout=5)
        return {"file": str(file), "png": str(png) if panel else None,
                "problem": None if panel else "Finder showed no Quick Look panel within 10 s"}
    finally:
        osascript(CLOSE_FINDER_WINDOW, window_id)
        untrack("finder_windows", window_id)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    return True


def open_in_app(file, run_dir, settle):
    # `open -n` starts a new instance even when one runs, so ending it leaves the setup window and the user's
    # instances alone. Ignoring the saved state stops a relaunch after a crash from restoring earlier windows.
    # The token in its arguments tells this instance apart from any other that starts meanwhile.
    token = f"bql-{uuid.uuid4()}"
    png = run_dir / "app" / f"{file.name}.png"
    log = run_dir / "app-loads.ndjson"
    instance = {}

    def find_instance():
        if not instance and (pids := run(["pgrep", "-f", "--", token]).stdout.split()):
            instance.update(pid=int(pids[0]), file=str(file), token=token)
            track("app", instance)
        return instance.get("pid")

    def app_windows(pid):
        return [w for w in windows() if w["pid"] == pid and w["layer"] == 0]

    def shown():
        """The window titled with the file, or True once the instance has exited."""
        pid = find_instance()
        if pid is None:
            return None
        if not alive(pid):
            return True
        # Finder's hide-extension setting can drop the extension from the window title.
        return next((w for w in app_windows(pid) if w.get("name") in (file.name, file.stem)), None)

    def result(problem):
        return {"file": str(file), "png": None if problem else str(png), "pid": instance.get("pid"),
                "problem": problem}

    try:
        with log_stream(log, "--signpost", "--predicate",
                        'process == "BrushesQuickLook" AND signpostName == "load"') as check_stream:
            try:
                proc = run(["open", "-n", "-a", str(APP), str(file),
                            "--args", "-ApplePersistenceIgnoreState", "YES", "-BQLLaunch", token], timeout=60)
            except subprocess.TimeoutExpired:
                return result("open -n -a did not return within 60 s")
            if proc.returncode != 0:
                return result(f"open -n -a exited {proc.returncode}: {proc.stderr.strip()}")
            window = wait_for(shown, timeout=20)
            pid = instance.get("pid")
            if pid is None:
                return result("the app did not start within 20 s")
            if window is True:
                return result("the app exited before it showed a window")
            if not window:
                titles = [w.get("name") for w in app_windows(pid)]
                if not titles:
                    return result("the app opened no window within 20 s")
                if not any(titles):
                    return result("the app's windows have no titles. Grant Screen Recording to the app running "
                                  "this shell in System Settings > Privacy & Security")
                return result(f"the app opened no window titled {file.name} within 20 s, only {titles}")
            # The window shows "Loading brushes…" until the load ends, which LoadBudget caps at 10 s plus 1 s of grace.
            wait_for(lambda: check_stream() or load_ended(log, pid) or not alive(pid), timeout=15)
            if alive(pid) and not load_ended(log, pid):
                return result("the app did not finish loading the file within 15 s")
            time.sleep(settle)
            try:
                capture(window["id"], png)
            except Fail:
                if alive(pid):
                    raise
                return result("the app exited while it showed the file")
            return result(None)
    finally:
        if (pid := find_instance()) is not None:
            try:
                os.kill(pid, 15)
                if not wait_for(lambda: not alive(pid), timeout=5):
                    os.kill(pid, 9)
            except ProcessLookupError:
                pass
            untrack("app", instance)


DRIVERS = {"qlmanage": preview_with_qlmanage, "finder": preview_with_finder}


def drive_previews(files, run_dir, settle, via):
    # On a hosted runner `log show` lost this activity for up to half of the previews. A live stream kept all of them.
    log = run_dir / "preview-requests.ndjson"
    with log_stream(log, "--predicate",
                    'process == "BrushesPreview" AND eventMessage == "beginning extension request"') as check_stream:
        results = []
        for file in files:
            # On a hosted runner about 1 in 300 qlmanage runs never gets the extension's view: the extension starts
            # its request but never receives preparePreviewOfFile, and qlmanage waits with no window. A new qlmanage
            # recovers. Each attempt keeps its own time span, so the proof names the request of the attempt that drew.
            attempts = 2 if via == "qlmanage" else 1
            for attempt in range(1, attempts + 1):
                began = time.time()
                result = DRIVERS[via](file, run_dir / "preview" / f"{file.name}.png", settle)
                if result["png"] or attempt == attempts:
                    break
                note(f"qlmanage opened no preview window for {file.name} within 20 s, starting a new one")
            result["attempts"] = attempt
            results.append((began, time.time(), result))

        def served():
            requests = extension_requests(log)
            return [next((process for at, process in requests if began <= at <= ended), None)
                    for began, ended, _ in results]

        # The stream writes an event a moment after it happens.
        wait_for(lambda: check_stream()
                 or all(process or not result["png"] for process, (_, _, result) in zip(served(), results)), timeout=5)
        check_stream()
    for process, (_, _, result) in zip(served(), results):
        result["extension"] = process
        if result["png"] and not process:
            result["problem"] = "the preview window opened but no BrushesPreview request ran for it"
        elif process and not (process["binary"] or "").startswith(str(APP)):
            result["problem"] = f"served by {process['binary']}, not the installed app. Run `bql doctor`."
    return [result for _, _, result in results]


