def privacy_problems(manifest, apis):
    try:
        root = plistlib.loads(manifest)
    except (ValueError, ExpatError) as error:
        return [("", f"is not a property list: {error}")]
    entries = root.get("NSPrivacyAccessedAPITypes") if isinstance(root, dict) else None
    if not isinstance(entries, list):
        return [("NSPrivacyAccessedAPITypes", f"is {entries!r}, expected an array")]
    problems, declared = [], set()
    for i, entry in enumerate(entries):
        key = f"NSPrivacyAccessedAPITypes[{i}]"
        if not isinstance(entry, dict):
            problems.append((key, f"is {entry!r}, expected a dictionary"))
            continue
        category = entry.get("NSPrivacyAccessedAPIType")
        if isinstance(category, str) and category in CATEGORIES:
            declared.add(category)
        else:
            problems.append((f"{key}.NSPrivacyAccessedAPIType", f"{category!r} is not a known category"))
        reasons = entry.get("NSPrivacyAccessedAPITypeReasons")
        if not isinstance(reasons, list) or not reasons:
            problems.append((f"{key}.NSPrivacyAccessedAPITypeReasons", f"is {reasons!r}, expected a non-empty array"))
            continue
        problems += [(f"{key}.NSPrivacyAccessedAPITypeReasons[{j}]", f"{reason!r} is not a reason code such as CA92.1")
                     for j, reason in enumerate(reasons)
                     if not isinstance(reason, str) or not REASON_CODE.fullmatch(reason)]
    for api in sorted(apis):
        needed = [category for category, members in CATEGORIES.items() if api in members]
        if needed and not declared.intersection(needed):
            problems.append(("NSPrivacyAccessedAPITypes", f"the binary uses {api}, which needs {' or '.join(needed)}"))
    return problems


def lint_error(path, text=None):
    # plistlib accepts an unknown XML tag that plutil rejects.
    proc = run(["plutil", "-lint", str(path)], input=text)
    if proc.returncode == 0:
        return None
    shown = "<stdin>" if path == "-" else path
    return f"is not a valid property list {(proc.stderr.strip() or proc.stdout.strip()).removeprefix(f'{shown}: ')}"


def imported_apis(binary):
    symbols = run(["nm", "-u", "-j", "-arch", "all", str(binary)], check=True).stdout.splitlines()
    methnames = run(["otool", "-arch", "all", "-v", "-s", "__TEXT", "__objc_methname", str(binary)], check=True).stdout
    selectors = re.findall(r"^[0-9a-f]+\s+(\S+)", methnames, re.M)
    return {name.removesuffix("$INODE64") for name in symbols + selectors}


def bundle_problems(kind, bundle):
    binary = bundle / "Contents/MacOS" / bundle.stem
    if not binary.is_file():
        return [(f"Contents/MacOS/{bundle.stem}", "is missing",
                 "Build Release with scripts/build.sh. project.yml embeds both extensions in the app.")]
    problems = []
    archs = run(["lipo", "-archs", str(binary)], check=True).stdout.split()
    if not {"arm64", "x86_64"} <= set(archs):
        problems.append((f"Contents/MacOS/{bundle.stem}", f"has architectures {archs}, expected arm64 and x86_64",
                         "Build Release with ONLY_ACTIVE_ARCH=NO, as scripts/build.sh does."))
    signature = run(["codesign", "-dv", str(bundle)], check=True).stderr
    flags = re.findall(r"\bflags=0x[0-9a-f]+\(([^)]*)\)", signature)
    if not flags or not all("runtime" in f.split(",") for f in flags):
        problems.append(("code signature", f"has no hardened runtime flag: {signature.strip()}",
                         "Keep ENABLE_HARDENED_RUNTIME: YES and OTHER_CODE_SIGN_FLAGS: --options runtime "
                         "in project.yml."))
    entitlements = run(["codesign", "-d", "--entitlements", "-", "--xml", str(bundle)], check=True).stdout
    if error := entitlements and lint_error("-", entitlements):
        problems.append(("entitlements", error, "Fix the target's entitlements in project.yml."))
    else:
        sandbox = plistlib.loads(entitlements.encode()).get("com.apple.security.app-sandbox") if entitlements else None
        if sandbox is not True:
            problems.append(("entitlements com.apple.security.app-sandbox", f"is {sandbox!r}, expected True",
                             "Set com.apple.security.app-sandbox: true in the target's entitlements in project.yml."))
    info_plist = bundle / "Contents/Info.plist"
    if error := lint_error(info_plist):
        return problems + [("Info.plist", error, "Fix the target's info properties in project.yml.")]
    info = plistlib.loads(info_plist.read_bytes())
    if kind == "app":
        types_key, expected_types = "UTImportedTypeDeclarations", "an array of type declarations"
        listed = info.get(types_key)
        types = ([declaration.get("UTTypeIdentifier") for declaration in listed]
                 if isinstance(listed, list) and all(isinstance(d, dict) for d in listed) else None)
        for key, (expected, fix) in APP_INFO.items():
            # A plist integer 0 equals False in Python. Apple types ITSAppUsesNonExemptEncryption as a Boolean.
            if type(info.get(key)) is not type(expected) or info.get(key) != expected:
                problems.append((f"Info.plist {key}", f"is {info.get(key)!r}, expected {expected!r}", fix))
        if not (bundle / "Contents/Resources/AppIcon.icns").is_file():
            problems.append(("Contents/Resources/AppIcon.icns", "is missing", ICON_FIX))
    else:
        types_key, expected_types = "NSExtension.NSExtensionAttributes.QLSupportedContentTypes", "an array of strings"
        listed = info.get("NSExtension", {}).get("NSExtensionAttributes", {}).get("QLSupportedContentTypes")
        types = listed if isinstance(listed, list) and all(isinstance(t, str) for t in listed) else None
    if types is None:
        problems.append((f"Info.plist {types_key}", f"is {listed!r}, expected {expected_types}", TYPES_FIX))
    elif missing := [t for t in UTTYPES if t not in types]:
        problems.append((f"Info.plist {types_key}", f"lacks {', '.join(missing)}", TYPES_FIX))
    manifest = bundle / "Contents/Resources" / MANIFEST
    if not manifest.is_file():
        return problems + [(MANIFEST, "is missing from Contents/Resources",
                            f"Add {MANIFEST} to the target's sources in project.yml with buildPhase: resources.")]
    if error := lint_error(manifest):
        return problems + [(MANIFEST, error, MANIFEST_FIX)]
    return problems + [(f"{MANIFEST} {key}".rstrip(), error, MANIFEST_FIX)
                       for key, error in privacy_problems(manifest.read_bytes(), imported_apis(binary))]


def check_build(app):
    if not (app / "Contents/Info.plist").is_file():
        raise Fail(f"{app} is not an app bundle", f"Pass a built BrushesQuickLook.app, such as {BUILD}.")
    return [(f"{bundle.name} {where}", error, fix)
            for kind, bundle in bundles(app).items() for where, error, fix in bundle_problems(kind, bundle)]


@dataclass(frozen=True)
class Process:
    kind: str
    pid: int
    path: Optional[str]
    elsewhere: bool
    verify_error: Optional[str]


@dataclass(frozen=True)
class Plugin:
    election: str
    path: str


@dataclass(frozen=True)
class Observed:
    app: str
    build: str
    installed: Optional[Dict[str, Optional[str]]]
    built: Optional[Dict[str, Optional[str]]]
    registered: List[str]
    plugins: Dict[str, List[Plugin]]
    processes: List[Process]


def readiness(observed):
    app, install = observed.app, "Run `bql install`."
    problems = []
    if observed.installed is None:
        problems.append(("installed", f"{app} is missing", install))
    if observed.built is None:
        problems.append(("release-build", f"{observed.build} is missing", install))
    if observed.installed and observed.built:
        problems += [(f"cdhash-{kind}", f"the installed {kind} has CDHash {observed.installed[kind]}, "
                      f"{observed.build} has {built}", f"The installed app is not that build. {install}")
                     for kind, built in observed.built.items()
                     if observed.installed[kind] is None or observed.installed[kind] != built]
    others = [path for path in observed.registered if path != app]
    if others:
        problems.append(("launchservices", f"other copies are registered: {', '.join(others)}",
                         f"Quick Look may route to them. {install} It unregisters every other copy."))
    if app not in observed.registered:
        problems.append(("launchservices", f"{app} is not registered", install))
    for kind, name in PLUGINS.items():
        expected = Plugin("+", f"{app}/Contents/PlugIns/{name}.appex")
        if observed.plugins[kind] != [expected]:
            listed = [f"{plugin.election} {plugin.path}" for plugin in observed.plugins[kind]]
            problems.append((f"pluginkit-{kind}", f"registrations: {listed or 'none'}",
                             f"Expected one registration elected for use (+) at {expected.path}. {install}"))
    for process in observed.processes:
        if process.elsewhere or process.verify_error is not None:
            restart = (f"`open` sends files to it. Run `kill {process.pid}`, then `open {app}`."
                       if process.kind == "app" else f"It keeps serving requests. Run `kill {process.pid}`. Quick "
                       "Look starts a fresh one from the installed app on the next request.")
            runs = process.path or "a deleted executable"
            problems.append((f"running-{process.kind}", f"pid {process.pid} runs {runs}"
                             + (f": {process.verify_error}" if process.verify_error is not None else ""),
                             f"This process does not run the installed binary. {restart}"))
    return problems


def registered():
    dump = run([LSREGISTER, "-dump"], timeout=120, check=True).stdout
    paths = set()
    for record in re.split(r"^-{20,}$", dump, flags=re.M):
        identifier = re.search(r"^\s*identifier:(.*)$", record, re.M)
        path = re.search(r"^\s*path:(.*?)(?: \(0x[0-9a-f]+\))?$", record, re.M)
        if identifier and path and identifier[1].strip() == BUNDLE_ID:
            paths.add(os.path.realpath(path[1].strip()))
    return sorted(paths)


def process_table():
    fix = "Rerun. bql cannot tell which processes run the app without the process table."
    count = 1024
    while True:
        pids = (ctypes.c_int * count)()
        filled = LIBPROC.proc_listpids(PROC_RUID_ONLY, os.getuid(), pids, ctypes.sizeof(pids))
        if filled <= 0:
            raise Fail(f"proc_listpids failed: {os.strerror(ctypes.get_errno())}", fix)
        if filled < ctypes.sizeof(pids):
            break
        count *= 2
    table = {}
    name = ctypes.create_string_buffer(2 * MAXCOMLEN)
    path = ctypes.create_string_buffer(PROC_PIDPATHINFO_MAXSIZE)
    for pid in pids[:filled // ctypes.sizeof(ctypes.c_int)]:
        if LIBPROC.proc_name(pid, name, ctypes.sizeof(name)) <= 0:
            # EPERM: PROC_RUID_ONLY lists setuid processes such as login by their real uid, and proc_name refuses them.
            # The app's processes are never setuid.
            if ctypes.get_errno() in (errno.ESRCH, errno.EPERM):
                continue
            raise Fail(f"proc_name {pid} failed: {os.strerror(ctypes.get_errno())}", fix)
        if LIBPROC.proc_pidpath(pid, path, ctypes.sizeof(path)) > 0:
            table[pid] = os.fsdecode(name.value), os.fsdecode(path.value)
        # ENOENT: no file is left at the executable's last path. The name outlives it, since the kernel keeps the
        # name of the file the process executed.
        elif ctypes.get_errno() in (errno.ESRCH, errno.ENOENT):
            table[pid] = os.fsdecode(name.value), None
        else:
            raise Fail(f"proc_pidpath {pid} failed: {os.strerror(ctypes.get_errno())}", fix)
    return table


def file_identity(path):
    try:
        stat = os.stat(path)
    except FileNotFoundError:
        return None
    return stat.st_dev, stat.st_ino


def bundle_identifier(executable):
    try:
        info = plistlib.loads((Path(executable).parent.parent / "Info.plist").read_bytes())
    except (OSError, ValueError, ExpatError):
        return None
    return info.get("CFBundleIdentifier") if isinstance(info, dict) else None


def app_processes(app):
    installed = {identity: kind for kind, executable in EXECUTABLES.items()
                 if (identity := file_identity(app / executable))}
    bundle = file_identity(app)
    copies = {BUNDLE_ID: "app", **{f"{BUNDLE_ID}.{kind}": kind for kind in PLUGINS}}
    names = {Path(executable).name: kind for kind, executable in EXECUTABLES.items()}
    found = []
    for pid, (name, path) in process_table().items():
        kind = installed.get(path and file_identity(path))
        elsewhere = kind is None
        if elsewhere:
            copy = path and copies.get(bundle_identifier(path))
            # `open -a APP` starts the copy at APP rather than use a host app running elsewhere, such as a Debug build.
            if copy == "app" and file_identity(Path(path).parent.parent.parent) != bundle:
                continue
            kind = copy or names.get(name)
            if kind is None:
                continue
        # A pid's CDHash is read from disk, so only `codesign -v` sees a file replaced under it at the same path.
        verify = run(["codesign", "-v", str(pid)])
        if verify.returncode not in (0, 1):
            raise Fail(f"codesign -v {pid} exited {verify.returncode}: {verify.stderr.strip()}",
                       "Run the command by hand to see the full error.")
        if not alive(pid):
            continue
        found.append(Process(kind, pid, path, elsewhere,
                             (verify.stderr.strip() or "codesign -v exited 1") if verify.returncode == 1 else None))
    return found


def observe(app, build):
    app, build = Path(os.path.realpath(app)), Path(os.path.realpath(build))

    def cdhashes(bundle):
        if not bundle.exists():
            return None
        return {kind: cdhash(path) if path.exists() else None for kind, path in bundles(bundle).items()}

    def plugins(kind):
        bundle_id = f"{BUNDLE_ID}.{kind}"
        listed = run(["pluginkit", "-m", "-v", "-A", "-i", bundle_id], check=True).stdout
        # A line starts with the election (+ use, - ignore, a space for none) and ends with a tab and the path.
        return [Plugin(line[:1], os.path.realpath(line.rsplit("\t", 1)[-1].strip()))
                for line in listed.splitlines() if bundle_id in line]

    return Observed(app=str(app), build=str(build), installed=cdhashes(app), built=cdhashes(build),
                    registered=registered(), plugins={kind: plugins(kind) for kind in PLUGINS},
                    processes=app_processes(app))


def cmd_doctor(args):
    observed = observe(APP, BUILD)
    result = {"repo": str(REPO), "observed": asdict(observed)}
    if BUILD.exists():
        tracked = run(["git", "-C", str(REPO), "ls-files", "--", *SOURCES], check=True).stdout.split()
        newest = max(((REPO / f).stat().st_mtime, f) for f in tracked if (REPO / f).exists())
        stale = newest[0] > (BUILD / "Contents/MacOS/BrushesQuickLook").stat().st_mtime
        result["build_fresh"] = {"newest_source": newest[1], "newer_than_build": stale}
        if stale:
            result["note"] = "A source file changed after the last Release build. Run `bql install` to verify it."
    problems = readiness(observed)
    emit(verdict(result, [(f"{name}: {error}", fix) for name, error, fix in problems]), 1 if problems else 0)


