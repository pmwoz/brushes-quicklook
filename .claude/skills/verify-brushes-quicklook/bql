def cdhash(path):
    match = re.search(r"^CDHash=(\w+)$", run(["codesign", "-dvvv", str(path)], check=True).stderr, re.M)
    if not match:
        raise Fail(f"codesign -dvvv {path} printed no CDHash", "Run the command by hand to see the full error.")
    return match.group(1)


