def remove_checkout(checkout):
    def attempt(args):
        try:
            run(args, check=True)
        except Fail as failure:
            return failure.error
        except subprocess.TimeoutExpired as error:
            return f"{' '.join(args)} did not return within {error.timeout:g} s"
        except OSError as error:
            return f"{' '.join(args)}: {error}"
        return None

    left = []
    # xcodebuild registers its product with LaunchServices, and the record outlives a deleted product. lsregister -u
    # also exits 1 on a path that is neither registered nor on disk, so the dump decides whether the record is gone.
    build = checkout / BUILD.relative_to(REPO)
    unregister = [LSREGISTER, "-u", str(build)]
    error = attempt(unregister)
    try:
        if str(build) in registered():
            left.append((f"cleanup: {error or f'{build} is still registered'}", f"Run `{' '.join(unregister)}`."))
    except (Fail, subprocess.TimeoutExpired, OSError) as failure:
        left.append((f"cleanup: cannot tell whether {build} is unregistered: {getattr(failure, 'error', failure)}",
                     f"Run `{' '.join(unregister)}`."))
    remove = ["git", "-C", str(REPO), "worktree", "remove", "--force", str(checkout)]
    if (error := attempt(remove)) and checkout.exists():
        if any(checkout.iterdir()):
            left.append((f"cleanup: {error}", f"Run `{' '.join(remove)}`."))
        else:
            checkout.rmdir()
    return left


def install(checkout, build_first):
    app = Path(os.path.realpath(APP))
    build = checkout / BUILD.relative_to(REPO)
    steps = []
    if build_first:
        note(f"building Release in {checkout}, this takes a few minutes")
        proc = run([str(checkout / "scripts/build.sh")], timeout=1800)
        if proc.returncode != 0:
            return steps, "build", [("scripts/build.sh", (proc.stderr.strip() or proc.stdout.strip())[-2000:],
                                     "Run the xcodebuild command from README.md to see the full compiler output.")]
        steps.append("build")
    elif not build.exists():
        raise Fail(f"--no-build needs a Release build at {build}",
                   "Run `bql install` without --no-build. In a Tart guest, run `vm sync` on the host first.")
    problems = check_build(build)
    if problems:
        return steps, "check-build", problems
    steps.append("check-build")

    stale = [path for path in registered() if path != str(app)]
    for path in stale:
        run([LSREGISTER, "-u", path], check=True)
    steps.append(f"unregister {len(stale)} stale paths")

    def app_pids():
        return [p.pid for p in app_processes(app) if p.kind == "app"]

    # The quit reply arrives before the process exits. `open` during the exit goes to the dying process.
    deadline = time.time() + 10
    request = osascript(f'with timeout of 10 seconds\ntell application id "{BUNDLE_ID}" to quit\nend timeout')
    wait_for(lambda: not app_pids(), timeout=deadline - time.time())
    pids = app_pids()
    if pids:
        return steps, "quit", [("quit", f"pid {' '.join(map(str, pids))} still runs {app} 10 s after the quit "
                                f"request. {request.stderr.strip()}".strip(),
                                "BrushesQuickLook did not quit, because a sheet or panel is open or another "
                                "instance runs. Close the sheet or `kill` the pids in the error, then rerun "
                                "`bql install`.")]
    steps.append("quit")

    for command in (["rm", "-rf", "--", str(app)], ["ditto", str(build), str(app)]):
        proc = run(command)
        if proc.returncode != 0:
            return steps, "replace", [("replace", f"{' '.join(command)} exited {proc.returncode}: "
                                       f"{proc.stderr.strip()}", "Check that /Applications is writable and the "
                                       "app is not open from a mounted image.")]
    steps.append("replace")

    run([LSREGISTER, "-f", "-R", str(app)], check=True)
    for name in PLUGINS.values():
        run(["pluginkit", "-a", str(app / f"Contents/PlugIns/{name}.appex")], check=True)
    run(["open", str(app)], check=True)
    state = load_state()
    state["host_app_opened"] = True
    save_state(state)
    for kind in PLUGINS:
        run(["pluginkit", "-e", "use", "-i", f"{BUNDLE_ID}.{kind}"], check=True)
    steps.append("register")

    problems = readiness(observe(app, build))
    if problems:
        return steps, "verify", problems
    steps.append("verify")
    return steps, None, []


def cmd_install(args):
    def outcome(checkout, build_first):
        steps, failed_step, problems = install(checkout, build_first)
        return ({"steps": steps, **({"failed_step": failed_step} if failed_step else {})},
                [(f"{name}: {error}", fix) for name, error, fix in problems])

    if not args.main:
        result, failures = outcome(REPO, not args.no_build)
        emit(verdict({**result, **({} if failures else {"next": "Run `bql doctor`."})}, failures),
             1 if failures else 0)
    run(["git", "-C", str(REPO), "fetch", "origin", "main"], timeout=600, check=True)
    checkout = Path(os.path.realpath(tempfile.mkdtemp()))
    try:
        run(["git", "-C", str(REPO), "worktree", "add", "--detach", str(checkout), "origin/main"], check=True)
        result, failures = outcome(checkout, True)
        code = 1 if failures else 0
    except Exception as error:
        result, failures, code = {}, [describe(error)], 2
    finally:
        left = remove_checkout(checkout)
    emit(verdict(result, failures + left), 2 if left else code)


